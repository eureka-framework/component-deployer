{
  "name": "eureka/component-deployer",
  "description": "PHP Installer & Deployer for projects based on Eureka Framework",
  "minimum-stability": "stable",
  "type": "project",
  "license": "MIT",

  "authors": [
    {
      "name": "Romain Cottard",
      "role": "Developer"
    }
  ],

  "autoload": {
    "psr-4": {
      "Eureka\\Component\\Deployer\\": "./src"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "Eureka\\Component\\Deployer\\Tests\\Unit\\": "./tests/unit"
    }
  },

  "config": {
    "sort-packages": true
  },

  "require": {
    "php": ">=8.3",

    "eureka/component-console": "^6.0||^7.0"
  },

  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.92.3",
    "phpstan/phpstan": "^2.1.33",
    "phpstan/phpstan-phpunit": "^2.0.11",
    "phpstan/phpstan-strict-rules": "^2.0.7",
    "phpunit/phpcov": "^11.0.3",
    "phpunit/phpunit": "^12.5.4",
    "shipmonk/composer-dependency-analyser": "^1.8.4"
  }
}
